# Copy to your shell environment or source this file. Every value below is the
# default, so an empty file behaves the same. See docs/operations.md.

# Library location. Windows default: %LOCALAPPDATA%\homefile
# HOMEFILE_DATA_DIR=/home/me/.local/share/homefile

# Import limits.
# HOMEFILE_MAX_FILE_MB=25
# HOMEFILE_MAX_PAGES=200
# HOMEFILE_MAX_PAGE_CHARS=200000
# HOMEFILE_CONFIRM_BELOW=0.8

# Provider. "fake" is offline, deterministic, and free.
# HOMEFILE_PROVIDER=fake
# HOMEFILE_ALLOW_NETWORK=0
# HOMEFILE_RUN_REQUEST_CAP=20
# HOMEFILE_RUN_TOKEN_CAP=20000
# HOMEFILE_RUN_COST_CAP_USD=0
# HOMEFILE_DAILY_COST_CAP_USD=0

# Local Ollama (requires HOMEFILE_ALLOW_NETWORK=1).
# HOMEFILE_OLLAMA_URL=http://127.0.0.1:11434
# HOMEFILE_OLLAMA_MODEL=llama3.2

# OpenAI-compatible endpoint. Requires HOMEFILE_ALLOW_NETWORK=1, a base URL, a
# model, both prices, and non-zero run and daily cost caps.
# HOMEFILE_CLOUD_BASE_URL=https://api.example.com/v1
# HOMEFILE_CLOUD_MODEL=example-model
# HOMEFILE_CLOUD_INPUT_PRICE_PER_1K=0.00
# HOMEFILE_CLOUD_OUTPUT_PRICE_PER_1K=0.00
# HOMEFILE_CLOUD_API_KEY_ENV=HOMEFILE_CLOUD_API_KEY
